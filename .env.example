# Intelligent Context — Environment Variables
#
# CONFIGURE AI PROVIDERS VIA THE WEB UI: http://localhost:9090/ui → Providers tab
# The UI is the primary way to manage provider keys, base URLs, and types.
# You can add unlimited providers of type OpenAI-compatible or Anthropic.
#
# The variables below are ONLY for optional one-time bootstrap convenience:
# if keys are set here AND no providers exist in the database yet on first
# startup, they are auto-seeded. After that, the web UI takes over completely.

# --- Proxy Mode ---
# IC_MODE=local          # 'local' (default, SQLite, 127.0.0.1) or 'server' (Postgres, 0.0.0.0)
# IC_PROXY_PORT=1234     # Port the proxy listens on
# IC_MGMT_PORT=9090      # Port the management API listens on
# IC_API_KEY=            # Optional: require this key on incoming proxy requests

# --- Database ---
# SQLITE_PATH=~/.intelligent-context/data/db.sqlite   # Local SQLite path

# Required by docker-compose.yml for the bundled Postgres container.
# Use a strong, unique value; the compose file refuses to start without it.
# POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql://user:pass@localhost:5432/intelligent_context   # Postgres URL

# --- Redis (server mode only) ---
# REDIS_URL=redis://localhost:6379

# --- Logging ---
# IC_LOG_LEVEL=info   # debug | info | warn | error

# ──────────────────────────────────────────────────────────────────────────
# ONE-TIME BOOTSTRAP (only used if no providers exist in DB yet)
# ──────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENCODE_API_KEY=...
