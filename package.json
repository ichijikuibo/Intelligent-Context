  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:sea": "node scripts/build-sea.mjs",
    "start": "node  dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:nowatch": "tsx src/index.ts",
